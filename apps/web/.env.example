# Origin of the Open Rocket.Chat gateway.
#
# In development this is only the proxy target — the browser still talks to the
# Vite dev server, which keeps the session cookie same-origin.
#
# In production, set it to the gateway's public origin. If that is a different
# site from this app, the gateway must also run with
# SESSION_COOKIE_SAMESITE=none over HTTPS and list this origin in CORS_ORIGINS.
VITE_GATEWAY_URL=http://localhost:4000

# Identifies the build to the persisted query cache.
#
# The cache in IndexedDB is keyed by this value, so a deployment that changes
# it forces every returning browser to start from a cold cache instead of
# restoring rooms and messages an older build wrote in a shape the new one no
# longer expects. Unset means `dev`, which is what you want locally.
#
# In CI, set it to something that changes per build — the commit SHA is the
# obvious choice: VITE_BUILD_ID=$GITHUB_SHA
VITE_BUILD_ID=

# API key for GIF search in the message box, from
# https://developers.giphy.com/dashboard/.
#
# Optional: leave it unset and each person can paste their own key under
# Settings → GIFs, which is stored in their browser and overrides this one.
# The key identifies the deployment to GIPHY rather than any user, so shipping
# it in the client bundle is what GIPHY's browser keys are for.
VITE_GIPHY_API_KEY=
